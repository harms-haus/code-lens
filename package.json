{
  "name": "@harms-haus/code-lens",
  "version": "0.3.0",
  "description": "LSP-powered CLI tool for code intelligence — diagnostics, references, definitions, and more",
  "type": "module",
  "bin": {
    "code-lens": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/lib.js",
      "types": "./dist/lib.d.ts"
    },
    "./client": {
      "import": "./dist/lib-client.js",
      "types": "./dist/lib-client.d.ts"
    },
    "./lsp": {
      "import": "./dist/lib-lsp.js",
      "types": "./dist/lib-lsp.d.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:regression": "vitest run --config vitest.config.regression.ts --maxWorkers 5",
    "test:regression:update": "vitest run --config vitest.config.regression.ts --maxWorkers 5 --update",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harms-haus/code-lens.git"
  },
  "keywords": [
    "lsp",
    "language-server",
    "cli",
    "code-intelligence"
  ],
  "license": "MIT",
  "dependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "commander": "^14.0.3",
    "cross-spawn": "^7.0.6",
    "vscode-languageserver-types": "^3.17.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^25.9.0",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "execa": "^9.6.1",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.6"
  }
}
